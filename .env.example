# Shopify Admin API (required)
# Create a custom app in Shopify Admin > Settings > Apps and sales channels > Develop apps
# Needs the read_orders scope. SHOPIFY_SHOP is the *.myshopify.com domain, not tagfit.store.
SHOPIFY_SHOP=your-store.myshopify.com
SHOPIFY_ADMIN_ACCESS_TOKEN=shpat_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Bosta API (optional — omit to fall back to Shopify's own fulfillment/tracking fields)
BOSTA_API_KEY=
BOSTA_BASE_URL=https://app.bosta.co/api/v2

# Google service account for reading the InstaPay/returns Google Sheet (optional —
# omit to skip collections/returns data). Share the sheet with the service
# account's client_email as a Viewer.
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_SHEET_ID=1-KdXJ5OTBa5rLKzo2maQZJa_NfWnCf1Uoepuyy1RtDQ

# How many days back to pull on every sync run
SYNC_LOOKBACK_DAYS=90
